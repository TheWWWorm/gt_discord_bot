{
  "name": "gt-discord-bot",
  "version": "2.0.0",
  "description": "Guardian Tales discord bot",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "pm2": "pm2 start dist/index.js --name gt-discord-bot"
  },
  "author": "WWWorm",
  "license": "ISC",
  "dependencies": {
    "animal-ids": "^1.0.1",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "log4js": "^6.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
