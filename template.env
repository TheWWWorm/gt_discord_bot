# create a .env file based on this one and fill the values

# Bot settings, comma separated list of prefixes to call the bot with
BOT_PREFIXES = give,gib,geben,git,sudo

# Discord token (https://discord.com/developers/applications)
DISCORD_TOKEN =

# Is production?
PROD =

# Optional: folder for the bot data (defaults to db/bases)
# DB_DIR =
